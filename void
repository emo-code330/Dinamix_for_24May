void lineMove(int pwm, float kp) { // движение по линии с датчиками
  int error = (leftSensor.mapRead()) - (rightSensor.mapRead() + 10);
  int Psost = error * kp;
  long leftPwr = pwm - Psost;
  long rightPwr = pwm + Psost;
  leftPwr = constrain(leftPwr, 0, 1000);
  rightPwr = constrain(rightPwr, 0, 1000);

  dxl_wb.goalVelocity(rightdveg, rightPwr);
  dxl_wb.goalVelocity(leftdveg, leftPwr * -1);
}




void lineMove(int pwr, float kp, int prd) { // движение по линии со временем
  long currentMillis = millis();
  while (millis() - currentMillis < prd) lineMove(pwr, kp);
}




void driveToCross(int pwr, float kp) { // движение на перекрестке
  while (leftSensor.mapRead() < 50 or rightSensor.mapRead() < 50) lineMove(pwr, kp);
}





void pMove(int error, int pwr, float kp){ // движение по линии с одим датчиком
  int Psost = error * kp;
  long leftPwr = leftPwr - Psost;
  long rightPwr = rightPwr + Psost;
  leftPwr = constrain(leftPwr, 0, 1000);
  rightPwr = constrain(rightPwr, 0, 1000);

  dxl_wb.goalVelocity(rightdveg, rightPwr);
  dxl_wb.goalVelocity(leftdveg, leftPwr * -1);
}




void turnLeft(int pwr, float kp, int prd){ // повернуть налево
  long currentMillis = millis();
  while (millis() - currentMillis < prd) pMove(leftSensor.mapRead() - 40, pwr, kp);
}




void turnRight(int pwr, float kp, int prd){ // повернуть вправо
  long currentMillis = millis();
  while (millis() - currentMillis < prd) pMove(40 - rightSensor.mapRead(), pwr, kp);
}




void stop () { //стоп
  dxl_wb.goalVelocity(rightdveg, 0);
  dxl_wb.goalVelocity(leftdveg, 0);
  delay(50);
}

void lineMoveToTower(int dist, int pwr, float kp) { // движение до банки
  int distance = dist + 10;
  while (distance > dist) {
    distance = distance + (GetDistant() - distance) / 2;
    lineMove(pwr, kp, 6);
  }
}


void findTower(int dist, int leftPwr, int rightPwr) { // найти банку
  dxl_wb.goalVelocity(rightdveg, rightPwr);
  dxl_wb.goalVelocity(leftdveg, leftPwr + 150);
  int distance = dist + 10;
  while (distance > dist or distance < 10) {
    distance = GetDistant();
    delay(50);
  }
  stop();
  
}



void led_off(){ //выключить диод
  digitalWrite(LED_BUILTIN, HIGH);
}



void led_on(){ // вкллючить диод
  digitalWrite(LED_BUILTIN, LOW);
}

void Move( int millis, int leftPwr, int rightPwr) {
  dxl_wb.goalVelocity(rightdveg, rightPwr);
  dxl_wb.goalVelocity(leftdveg, leftPwr * -1);
  delay(millis);
  stop();
}


void around_tower( int rightPwr, int leftPwr) { // обьехать банку

    Move(880, -650,0);
    while( (leftSensor.mapRead()) < 50) {
    dxl_wb.goalVelocity(rightdveg, rightPwr);
    dxl_wb.goalVelocity(leftdveg, leftPwr);
  }
  delay(50);
  stop();

}




void moveToTower(int distToStop, int distToFind, int leftPwr, int rightPwr){ // движение до банки
  int distance = distToStop + 10;
  while (distance > distToStop or distance < 10) {
    distance += (GetDistant() - distance) * 0.7;
    if (distance > distToFind) {
      findTower(distToFind, leftPwr, rightPwr);
    }
    else Move(10, 320, 300);
  }
}





